{
  "format": "ragu-setup-manifest-v1",
  "artifacts": {
    "source": {
      "encoding": "git archive --format=tar <provenance.git_commit>",
      "sha256": "<SHA-256 of the complete source archive stream>"
    },
    "dependencies": {
      "lockfile": "source:Cargo.lock",
      "sha256": "<SHA-256 of Cargo.lock; every registry package must have an archive checksum>",
      "content_binding": "Cargo.lock checksum entries are SHA-256 digests of registry crate archives; separately hash any other dependency sources"
    },
    "public_parameters": {
      "generation": "<generator and byte encoding in the frozen source>",
      "sha256": "<SHA-256 of the public parameter bytes>"
    }
  },
  "build": {
    "toolchain": "<exact Rust toolchain>",
    "target": "<target triple>",
    "features": ["<enabled feature>"],
    "configuration": {
      "<build option>": "<value>"
    }
  },
  "setup": {
    "application_builder": "<concrete ApplicationBuilder<C, R, HEADER_SIZE, B> type>",
    "application_steps": [
      {
        "type": "<registered Step type, in registration order>",
        "configuration": {
          "<step input determining its circuit>": "<value or artifact reference>"
        }
      }
    ],
    "configuration": {
      "<remaining setup option>": "<value>"
    },
    "native_registry": "<ordered circuit manifest or committed-code reference>",
    "nested_registry": "<ordered circuit manifest or committed-code reference>",
    "fields_and_domains": "<explicit definitions or committed-code references>",
    "ranks_and_capacities": "<explicit values or committed-code references>",
    "transcript_rules_and_dst": "<explicit rules or committed-code references>"
  },
  "beacon": {
    "source": "bitcoin-mainnet",
    "height_rule": "earliest verified OpenTimestamps Bitcoin attestation height + 100",
    "tag_derivation": "source:crates/ragu_circuits/src/beacon.rs::Tag::from_beacon",
    "native_registry_label": "ragu_pcd native registry",
    "nested_registry_label": "ragu_pcd nested registry"
  },
  "provenance": {
    "git_commit": "<full Git commit ID of the frozen codebase snapshot>"
  }
}
